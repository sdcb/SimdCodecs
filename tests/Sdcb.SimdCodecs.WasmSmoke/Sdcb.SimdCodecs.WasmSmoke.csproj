<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- Mono AOT (browser-wasm) smoke test; not part of SimdCodecs.slnx. It compiles the NativeAOT
       smoke test's sources, so run.sh can diff its output against the JIT's: Mono AOT is the
       runtime of browser-wasm, iOS and Android, and compiles generic code and delegates its own
       way. Needs the wasm-tools workload and Node.js. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <RunAOTCompilation>true</RunAOTCompilation>
    <CompressionEnabled>false</CompressionEnabled>
    <!-- A smoke test, not a shipped app: emscripten at -O1 instead of the Release default cuts
         the publish by a quarter, and the output must still equal the JIT's. -->
    <EmccCompileOptimizationFlag>-O1</EmccCompileOptimizationFlag>
    <EmccLinkOptimizationFlag>-O1</EmccLinkOptimizationFlag>
    <WasmNativeDebugSymbols>false</WasmNativeDebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Sdcb.SimdCodecs.AotSmoke\*.cs" />
    <ProjectReference Include="..\..\src\Sdcb.SimdCodecs\Sdcb.SimdCodecs.csproj" />
  </ItemGroup>

  <Import Project="..\Sdcb.SimdCodecs.AotSmoke\Fixtures.props" />

</Project>
