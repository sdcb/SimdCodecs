<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);SIMDCODECS_WEBP</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <PackageId>Sdcb.SimdCodecs.Webp</PackageId>
    <Product>Sdcb.SimdCodecs.Webp</Product>
    <Authors>sdcb</Authors>
    <Description>Pure-managed WebP decoder for .NET: VP8 lossy, VP8L lossless, ALPH transparency, animation (full-canvas compositing, seek, timing) and ICC/EXIF/XMP metadata. Spec-derived from RFC 6386 / RFC 9649. No encoder. AOT-compatible.</Description>
    <PackageTags>webp image codec decoder lossy lossless vp8 vp8l alpha animation aot</PackageTags>
    <RepositoryUrl>https://github.com/sdcb/SimdCodecs.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sdcb/SimdCodecs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sdcb.SimdCodecs.Tests" />
    <InternalsVisibleTo Include="Sdcb.SimdCodecs.Webp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sdcb.SimdCodecs.Abstractions\Sdcb.SimdCodecs.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared source, compiled into this assembly under its own namespace: see src/Shared/MqDecoder.cs. -->
    <Compile Include="..\Shared\ExifOrientation.cs" Link="Shared\ExifOrientation.cs" />
  </ItemGroup>

</Project>
