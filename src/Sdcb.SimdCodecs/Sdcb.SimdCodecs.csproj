<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <PackageId>Sdcb.SimdCodecs</PackageId>
    <Product>Sdcb.SimdCodecs</Product>
    <Authors>sdcb</Authors>
    <Description>Image-codec facade over the Sdcb.SimdCodecs family: sniff a byte stream's format by its magic-byte signature and dispatch to the matching decoder (PNG, JPEG, TIFF, JBIG2, JPEG 2000, WebP, GIF, BMP, ICO, CUR), returning a codec-neutral IDecodedImage (fidelity tier: native bit depth + ColorEncoding colour signalling, with a ToFloats() RGBA float32 view) or decoding zero-copy into a caller-provided 8-bit RGBA buffer (display tier, integer-sample formats). AOT-compatible.</Description>
    <PackageTags>image codec facade decoder sniff dispatch png jpeg tiff jbig2 jpeg2000 jp2 j2k webp gif bmp ico cur hdr aot</PackageTags>
    <RepositoryUrl>https://github.com/sdcb/SimdCodecs.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sdcb/SimdCodecs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sdcb.SimdCodecs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sdcb.SimdCodecs.Abstractions\Sdcb.SimdCodecs.Abstractions.csproj" />
    <ProjectReference Include="..\Sdcb.SimdCodecs.Png\Sdcb.SimdCodecs.Png.csproj" />
    <ProjectReference Include="..\Sdcb.SimdCodecs.Jpeg\Sdcb.SimdCodecs.Jpeg.csproj" />
    <ProjectReference Include="..\Sdcb.SimdCodecs.Jpeg.GainMap\Sdcb.SimdCodecs.Jpeg.GainMap.csproj" />
    <ProjectReference Include="..\Sdcb.SimdCodecs.Tiff\Sdcb.SimdCodecs.Tiff.csproj" />
    <ProjectReference Include="..\Sdcb.SimdCodecs.Jbig2\Sdcb.SimdCodecs.Jbig2.csproj" />
    <ProjectReference Include="..\Sdcb.SimdCodecs.Jpeg2000\Sdcb.SimdCodecs.Jpeg2000.csproj" />
    <ProjectReference Include="..\Sdcb.SimdCodecs.Webp\Sdcb.SimdCodecs.Webp.csproj" />
    <ProjectReference Include="..\Sdcb.SimdCodecs.Gif\Sdcb.SimdCodecs.Gif.csproj" />
    <ProjectReference Include="..\Sdcb.SimdCodecs.Bmp\Sdcb.SimdCodecs.Bmp.csproj" />
    <ProjectReference Include="..\Sdcb.SimdCodecs.Ico\Sdcb.SimdCodecs.Ico.csproj" />
  </ItemGroup>

</Project>
