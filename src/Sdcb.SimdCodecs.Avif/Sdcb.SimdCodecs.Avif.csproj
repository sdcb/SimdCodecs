<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);SIMDCODECS_AVIF</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <PackageId>Sdcb.SimdCodecs.Avif</PackageId>
    <Product>Sdcb.SimdCodecs.Avif</Product>
    <Authors>sdcb</Authors>
    <Description>Pure-managed AVIF decoder for .NET: ISOBMFF container (ISO/IEC 14496-12 / 23008-12), AVIF item and sequence model (AOM AVIF v1.1.0), and AV1 decoding across Main (0), High (1) and Professional (2) profiles (8, 10 and 12 bits; 4:2:0, 4:2:2, 4:4:4 and 4:0:0), grids, alpha, HDR / gain maps, transforms and animated sequences.</Description>
    <PackageTags>avif av1 image codec decoder isobmff grid animation aot</PackageTags>
    <RepositoryUrl>https://github.com/sdcb/SimdCodecs.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sdcb/SimdCodecs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sdcb.SimdCodecs.Tests" />
    <InternalsVisibleTo Include="Sdcb.SimdCodecs.Avif.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sdcb.SimdCodecs.Abstractions\Sdcb.SimdCodecs.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\IccPrimaries.cs" Link="Shared\IccPrimaries.cs" />
    <Compile Include="..\Shared\ExifOrientation.cs" Link="Shared\ExifOrientation.cs" />
    <Compile Include="..\Shared\Isobmff\BoxReader.cs" Link="Shared\Isobmff\BoxReader.cs" />
    <Compile Include="..\Shared\Isobmff\ItemContainer.cs" Link="Shared\Isobmff\ItemContainer.cs" />
    <Compile Include="..\Shared\Isobmff\ExifItem.cs" Link="Shared\Isobmff\ExifItem.cs" />
  </ItemGroup>

</Project>
