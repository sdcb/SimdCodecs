<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <DefineConstants>$(DefineConstants);SIMDCODECS_GIF</DefineConstants>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <PackageId>Sdcb.SimdCodecs.Gif</PackageId>
    <Product>Sdcb.SimdCodecs.Gif</Product>
    <Authors>sdcb</Authors>
    <Description>Pure-managed GIF (87a / 89a) decoder and encoder for .NET. Decodes still and animated images (interlacing, transparency, every disposal method, loop count) to composited full-canvas RGBA frames with random access. Encodes stills and animations: lossless when the colours fit a palette, otherwise Wu quantization with optional Floyd-Steinberg dithering; opaque animations store only what changed. Spec-derived from the GIF89a specification. AOT-compatible.</Description>
    <PackageTags>gif image codec decoder encoder animation lzw quantization aot</PackageTags>
    <RepositoryUrl>https://github.com/sdcb/SimdCodecs.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sdcb/SimdCodecs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sdcb.SimdCodecs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\PaletteQuantizer.cs" Link="Shared\PaletteQuantizer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sdcb.SimdCodecs.Abstractions\Sdcb.SimdCodecs.Abstractions.csproj" />
  </ItemGroup>

</Project>
