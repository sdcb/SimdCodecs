<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);SIMDCODECS_QOI</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <PackageId>Sdcb.SimdCodecs.Qoi</PackageId>
    <Product>Sdcb.SimdCodecs.Qoi</Product>
    <Authors>sdcb</Authors>
    <Description>Pure-managed QOI ("Quite OK Image") decoder and encoder for .NET, written from the QOI specification. Decodes RGB and RGBA images straight into a caller's buffer in any 8-bit layout with no allocation; encodes from RGBA, BGRA, RGB, BGR or grey, to an array or a stream. AOT-compatible.</Description>
    <PackageTags>qoi image codec decoder encoder lossless aot</PackageTags>
    <RepositoryUrl>https://github.com/sdcb/SimdCodecs.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sdcb/SimdCodecs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sdcb.SimdCodecs.Tests" />
    <InternalsVisibleTo Include="Sdcb.SimdCodecs.QoiPnm.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared source, compiled into this assembly under its own namespace: see src/Shared/MqDecoder.cs. -->
    <Compile Include="..\Shared\BufferWriters.cs" Link="Shared\BufferWriters.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sdcb.SimdCodecs.Abstractions\Sdcb.SimdCodecs.Abstractions.csproj" />
  </ItemGroup>

</Project>
