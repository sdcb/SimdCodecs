<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- ImageSharp advisories (NU190x) concern hostile input; this tool only reads the images it
         generates itself and is never shipped. -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- Black-box decode competitor only. Never read or decompile its source (see AGENTS.md). -->
    <PackageReference Include="Magick.NET-Q16-HDRI-AnyCPU" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.SimdCodecs.Heif\Sdcb.SimdCodecs.Heif.csproj" />
  </ItemGroup>

  <!--
    Native competitors, copied from the pinned vcpkg build so every run (including BenchmarkDotNet's
    child processes) loads the same bytes. Override HEIF_NATIVE_SOURCE to use another build; the
    version is checked at start-up (libheif 1.23.1, libde265 1.1.1).
    Fixtures are not copied: HeifInputs reads them from the test fixtures directory, or HEIF_INPUTS.
  -->
  <PropertyGroup>
    <HeifNativeSource Condition="'$(HeifNativeSource)' == ''">C:\_\3rd\vcpkg\installed\x64-windows\bin</HeifNativeSource>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(HeifNativeSource)\heif.dll')">
    <None Include="$(HeifNativeSource)\heif.dll" CopyToOutputDirectory="PreserveNewest" Link="heif.dll" />
    <None Include="$(HeifNativeSource)\libde265.dll" CopyToOutputDirectory="PreserveNewest" Link="libde265.dll" />
  </ItemGroup>

</Project>
