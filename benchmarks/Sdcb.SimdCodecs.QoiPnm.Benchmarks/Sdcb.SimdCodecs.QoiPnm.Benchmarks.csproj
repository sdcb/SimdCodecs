<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Not a shipped package: this project exists to measure the ones that are. -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- ImageSharp advisories (NU190x) concern hostile input; this tool only reads the images it
         generates itself and is never shipped. -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Black-box competitor only. Never read or decompile its source (see AGENTS.md). -->
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.SimdCodecs.Qoi\Sdcb.SimdCodecs.Qoi.csproj" />
    <ProjectReference Include="..\..\src\Sdcb.SimdCodecs.Pnm\Sdcb.SimdCodecs.Pnm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PNG benchmark's two source images (photo, screen), shared rather than copied. -->
    <Compile Include="..\Sdcb.SimdCodecs.Png.Benchmarks\Sources.cs" Link="Sources.cs" />
  </ItemGroup>

</Project>
