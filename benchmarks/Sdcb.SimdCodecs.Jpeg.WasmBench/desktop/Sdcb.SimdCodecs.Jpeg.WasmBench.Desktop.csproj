<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop-JIT side of the wasm comparison: the same sources, the same embedded images.
       Same assembly name as the wasm project, which is what InternalsVisibleTo names. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Sdcb.SimdCodecs.Jpeg.WasmBench</AssemblyName>
    <RootNamespace>Sdcb.SimdCodecs.Jpeg.WasmBench</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Stages.cs;..\Verify.cs;..\Program.cs" />
    <ProjectReference Include="..\..\..\src\Sdcb.SimdCodecs\Sdcb.SimdCodecs.csproj" />
  </ItemGroup>

  <Import Project="..\Images.props" />

</Project>
