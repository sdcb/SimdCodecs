<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Not a shipped package: this project exists to measure the ones that are. -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.SimdCodecs.Webp\Sdcb.SimdCodecs.Webp.csproj" />
    <ProjectReference Include="..\..\src\Sdcb.SimdCodecs.Png\Sdcb.SimdCodecs.Png.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="webp-inputs\*.webp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
