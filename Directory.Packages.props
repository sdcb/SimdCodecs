<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <!-- Sdcb.SimdCodecs.Tests (xunit v3 + Shouldly). -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Test-only black-box encoder/decoder (ImageMagick: libjpeg, libtiff, PNG) used to build
         inputs and as an independent oracle. Q16-HDRI so 16-bit and float rasters stay exact. -->
    <PackageVersion Include="Magick.NET-Q16-HDRI-AnyCPU" Version="14.13.1" />
    <!-- benchmarks/* only; never a dependency of a shipped package. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Benchmark competitor (black box only — never read its source). 3.1.12 is the newest release that
         builds without a Six Labors license key (3.2.0 and 4.x enforce one at build time). Bumping it means re-recording
         benchmarks/results. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>
